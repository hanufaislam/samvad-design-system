---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Specimen from './Specimen.astro';
import CodeBlock from '../component-docs/CodeBlock.astro';
import entries from './content.json';
import {href} from '../../data';
import stylesheet from './foundations.css?raw';
import '../../styles/component-docs.css';
import './foundations.css';
const {entry}=Astro.props as {entry:typeof entries[number]};
const examples:Record<string,string>={
 'for-designers':`Handoff checklist\n1. Component + variant + size\n2. Content, constraints and states\n3. Keyboard focus and announcements\n4. Responsive wrapping and both themes\n5. Approved token IDs / explicit pending decisions\n6. Links to the component and complete pattern`,
 'for-developers':`---\n// website/src/pages/example.astro\nimport Button from '../components/actions/Button.astro';\n---\n<Button variant="primary" size="medium">Check details</Button>\n<!-- Connect to the real operation in the consuming integration. -->`,
 'spacing-and-layout':`---\nimport Stack from '../components/layout/Stack.astro';\n---\n<Stack gap={24}><p>Instruction</p><p>Related content</p></Stack>`,
 grid:`---\nimport Grid from '../components/layout/Grid.astro';\n---\n<!-- Content columns; distinct from the foundation 4/8/12 page grid. -->\n<Grid columns={1} medium={2} wide={3} gap={24}>\n  <p>First reference</p><p>Second reference</p><p>Third reference</p>\n</Grid>`,
 'shape-and-radius':`.reference-shape { border-radius: var(--samvad-semantic-radius-full); }\n/* Equivalent capsule geometry; no new raw radius. */`,
 'borders-and-focus':`.reference-surface { border: var(--samvad-semantic-border-width-1) solid var(--samvad-semantic-color-border-default); }\n.reference-control:focus-visible {\n  outline: var(--samvad-semantic-border-width-2) solid var(--samvad-semantic-color-focus-default);\n  outline-offset: var(--samvad-semantic-focus-offset);\n}\n/* Prefer the existing field/button component for actual controls. */`,
 'elevation-and-shadows':`.reference-popup { box-shadow: var(--samvad-component-popup-shadow-default); }\n.reference-field { box-shadow: var(--samvad-component-field-shadow-default); }\n.reference-toast { box-shadow: var(--samvad-component-toast-notification-shadow-default); }\n/* Existing component CSS already consumes these aliases. */`,
 iconography:`---\nimport IconButton from '../components/actions/IconButton.astro';\n---\n<IconButton label="Mark reference reviewed" icon="check-circle" toggle />`,
 illustration:`Decorative artwork: use an empty text alternative (alt="").\nInformative artwork: provide an equivalent explanation in text.\nUse only approved existing palette/token mappings.\nNo production illustration or mascot asset is approved by this page.`,
 accessibility:`---\nimport TextInput from '../components/forms/TextInput.astro';\n---\n<TextInput id="unique-reference-title" label="Reference title"\n  helper="Use a descriptive title." required />`,
 'interaction-principles':`---\nimport Button from '../components/actions/Button.astro';\nimport TextLink from '../components/actions/TextLink.astro';\n---\n<Button type="button">Check details</Button>\n<TextLink href="/patterns/forms/">Read the form pattern</TextLink>`,
 motion:stylesheet.split('/* motion specimen */')[1].split('/* end motion specimen */')[0].trim()
};
const code=examples[entry.slug];const language=code.startsWith('---')?'Astro':['for-designers','illustration'].includes(entry.slug)?'Text':'CSS';
const toc=[{id:'intent',label:'Purpose'},{id:'specimen',label:'Examples and values'},{id:'usage',label:'Usage guidance'},{id:'accessibility',label:'Accessibility'},{id:'implementation',label:'Implementation'},{id:'related',label:'Related references'}];
---
<DocsLayout page={entry.id} toc={toc}><article class="component-docs foundation-docs">
 <section id="intent" class="doc-section"><h2>{entry.group==='Get started'?'A practical starting point.':'One foundation, shared decisions.'}</h2><p>{entry.why}</p><p class="component-preview-notice">Values come from approved foundation sources and the closed 629-token system. Examples reuse existing components. No new design values or native Figma changes.</p></section>
 <section id="specimen" class="doc-section"><h2>Examples and approved values</h2><div data-foundation-specimen><Specimen slug={entry.slug}/></div></section>
 <section id="usage" class="doc-section"><h2>Use with intent</h2><ul class="checklist">{entry.rules.map(text=><li>{text}</li>)}</ul></section>
 <section id="accessibility" class="doc-section"><h2>Accessibility in context</h2><ul class="checklist">{entry.access.map(text=><li>{text}</li>)}</ul></section>
 <section id="implementation" class="doc-section"><h2>Implementation guidance</h2>{entry.implementation.map(text=><p>{text}</p>)}<p class="source-note">{language==='Astro'?'Minimal reusable example for website/src/pages/. This is a subset of the live specimen, not a new package API.':language==='Text'?'A copyable working checklist; no API or asset approval is implied.':'Existing token references for a documentation specimen. Actual controls should use the reusable components.'}</p><CodeBlock code={code} language={language}/></section>
 <section id="related" class="doc-section"><h2>Related references</h2><ul>{entry.related.map(([label,path])=><li><a href={href(path)}>{label}</a></li>)}</ul><h3>Token references</h3><ul>{entry.tokens.map(id=><li><code>{id}</code></li>)}</ul><p>Inspect values, modes, provenance and candidate status in the <a href={href('design-tokens/')}>token registry</a>. Consuming an existing candidate alias does not ratify unrelated role mappings.</p></section>
</article></DocsLayout>
