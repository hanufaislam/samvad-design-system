---
import {foundation,href} from '../../data';
import registry from '../../../../design-system/tokens/dist/registry.json';
import Stack from '../layout/Stack.astro';
import Grid from '../layout/Grid.astro';
import Card from '../library/Card.astro';
import Button from '../actions/Button.astro';
import IconButton from '../actions/IconButton.astro';
import TextInput from '../forms/TextInput.astro';
import Select from '../forms/Select.astro';
import Switch from '../forms/Switch.astro';
import EmptyState from '../library/EmptyState.astro';
import Popover from '../library/Popover.astro';
import ToastNotification from '../library/ToastNotification.astro';
import Icon from '../Icon.astro';
const {slug}=Astro.props as {slug:string};
const levels=registry.filter(t=>/^Semantic\/elevation\/[0-4]$/.test(t.id));
const timings=registry.filter(t=>/^Semantic\/motion\/duration\/(fast|base|slow|loading)$/.test(t.id));
const easing=registry.filter(t=>/^Primitives\/motion\/easing\/(standard|enter|exit)$/.test(t.id));
---
{slug==='for-designers'&&<Grid columns={1} medium={2} wide={2} gap={24}><Card title="Choose the parts" description="Identify the component, variant and content constraints."><TextInput id="designer-label" label="Reference title" helper="Label 14/20/600; helper 14/22/400."/><a href={href('components/inputs/text-input/')}>Inspect the field API</a></Card><Card title="Describe the behaviour" description="Include validation, focus, busy state and recovery in the handoff."><a href={href('patterns/forms/')}>Review the complete form interaction</a></Card></Grid>}
{slug==='for-developers'&&<Stack gap={16}><Button data-guide-ack>Check local example</Button><p role="status" data-guide-status>This action is local. It does not call an API.</p><a href={href('resources/developer-handoff/')}>Read the integration checklist</a></Stack>}
{slug==='spacing-and-layout'&&<Stack gap={24}><div class="scale-list">{foundation.spacing.map(n=><div class="scale-row"><code>{n}px</code><span class="scale-track"><span class="scale-bar" style={`inline-size:var(--samvad-semantic-space-scale-${n})`} aria-hidden="true"></span></span><code>space/scale/{n}</code></div>)}</div><Select id="foundation-gap" label="Try an approved Stack gap" value="16" options={[8,12,16,24,32].map(n=>({value:String(n),label:`${n}px`}))} data-guide-gap/><Stack data-guide-stack gap={16}><Card title="Label and instruction" description="Related content stays close."/><Card title="Next related section" description="Change the gap to compare the grouping."/></Stack></Stack>}
{slug==='grid'&&<Stack gap={24}><div class="foundation-column-grid" aria-hidden="true">{Array.from({length:12},(_,i)=><span style={`--_column-index:${i+1}`}></span>)}</div><p data-guide-grid-status role="status">The page grid follows the current viewport.</p><div class="table-wrap"><table class="data-table"><caption>Approved page grid, independent of content Grid defaults</caption><thead><tr><th scope="col">Range</th><th scope="col">Columns</th><th scope="col">Gutter / margin</th></tr></thead><tbody>{foundation.layout.map(l=><tr><th scope="row">{l.name}: {l.min}–{l.max??'∞'}</th><td>{l.columns}</td><td>{l.gutter}px / {l.margin}px</td></tr>)}</tbody></table></div></Stack>}
{slug==='shape-and-radius'&&<div class="foundation-samples">{Object.entries(foundation.radius).map(([name,value])=><figure><div class="radius-sample" style={`border-radius:var(--samvad-semantic-radius-${name})`} aria-hidden="true"></div><figcaption><code>{name}</code><br/>{value}px</figcaption></figure>)}</div>}
{(slug==='borders-and-focus'||slug==='accessibility')&&<Stack gap={24}><Card title="Quiet structure" description="Neutral/200 in Light; neutral/800 in Dark. This is not a required input boundary."/><TextInput id="foundation-focus" label="Reference title" helper="Required control boundary: neutral/500. Tab here to inspect the 2px ring and 2px offset." required/><Button data-guide-ack>Check focus and activation</Button><p role="status" data-guide-status>Use Tab and Enter. No data is saved.</p></Stack>}
{slug==='elevation-and-shadows'&&<Stack gap={32}><div class="foundation-samples">{levels.map(t=><figure><div class="elevation-sample" style={`box-shadow:var(${t.css})`}>{t.name.split('/')[1]}</div><figcaption><code>{t.name}</code></figcaption></figure>)}</div><div class="table-wrap"><table class="data-table"><caption>Resolved foundation levels</caption><thead><tr><th scope="col">Level</th><th scope="col">Light</th><th scope="col">Dark</th></tr></thead><tbody>{levels.map(t=><tr><th scope="row">{t.name}</th><td><code>{t.resolved.Light}</code></td><td><code>{t.resolved.Dark}</code></td></tr>)}</tbody></table></div><TextInput id="foundation-shadow" label="Approved field shadow exception" helper="This soft treatment deliberately differs from the foundation levels."/><Stack direction="horizontal" gap={16}><Popover id="foundation-popover" title="Foundation elevation/2" description="This uses the actual popup implementation and its approved mode mappings." triggerLabel="Open actual popover"/><ToastNotification id="foundation-toast" message="A local specimen of the approved toast shadow." triggerLabel="Show actual toast"/></Stack></Stack>}
{slug==='iconography'&&<Stack gap={24}><div class="foundation-samples">{[16,20,24].map(size=><figure><Icon name="chat-circle" size={size}/><figcaption>Regular · {size}px</figcaption></figure>)}<figure><span aria-hidden="true" class="foundation-fill-icon"></span><figcaption>Existing Fill asset</figcaption></figure></div><Stack direction="horizontal" gap={16} align="center"><IconButton icon="check-circle" label="Mark reference reviewed" toggle/><span>Artwork 20px; the actual control retains its approved target size.</span></Stack><a href={href('icons/LICENSE')}>Phosphor MIT attribution</a></Stack>}
{slug==='illustration'&&<Grid columns={1} medium={2} wide={2} gap={24}><Card title="Direction reference, not a new asset" description="An existing Phosphor icon illustrates the conversation motif. This is not an approved production illustration or logo."><div class="illustration-reference" aria-hidden="true"><Icon name="chat-circle" size={24}/><Icon name="chat-circle" size={24}/></div><p>Use a restrained palette and let the message remain primary.</p></Card><EmptyState title="Nothing collected yet" description="Clear language and one next step work without decorative artwork."><a href={href('patterns/empty-states/')}>See useful recovery paths</a></EmptyState></Grid>}
{slug==='interaction-principles'&&<Stack gap={24}><TextInput id="foundation-interaction" label="Example reference" helper="A visible label remains useful in every state."/><Switch id="foundation-switch" label="Enable local example option" helper="Space toggles the native switch; focus remains visible."/><Button data-guide-ack>Acknowledge locally</Button><p role="status" data-guide-status>Ready. This specimen does not save a setting.</p></Stack>}
{slug==='motion'&&<Stack gap={24}><div class="table-wrap"><table class="data-table"><caption>Approved durations, including the explicit loading exception</caption><thead><tr><th scope="col">Role</th><th scope="col">Value</th></tr></thead><tbody>{timings.map(t=><tr><th scope="row">{t.name}</th><td>{t.resolved.Light}</td></tr>)}</tbody></table></div><div class="foundation-samples">{easing.map(t=>{const p=t.values as number[];return <figure><svg viewBox="0 0 100 100" width="96" height="96" role="img" aria-label={`${t.name}: ${p.join(', ')}`}><path d="M 0 100 L 100 100 L 100 0" fill="none" stroke="currentColor"/><path d={`M 0 100 C ${p[0]*100} ${100-p[1]*100}, ${p[2]*100} ${100-p[3]*100}, 100 0`} fill="none" stroke="currentColor" stroke-width="2"/></svg><figcaption>{t.name.split('/').at(-1)}</figcaption></figure>})}</div><div class="foundation-motion" data-guide-motion><Button data-guide-motion-toggle aria-pressed="false">Play movement</Button><div class="motion-track" aria-hidden="true"><span class="motion-mark"></span></div><p role="status" data-guide-motion-status>Ready. Explicit toggle only; respects reduced motion.</p></div></Stack>}
<script>import './runtime';</script>
