---
import {href} from '../../data';
import DocsLayout from '../../layouts/DocsLayout.astro';
import LibraryPlayground from './LibraryPlayground.astro';
import CodeBlock from './CodeBlock.astro';
import type {LibraryEntry} from '../library/catalog';
import '../../styles/component-docs.css';
const {entry:e}=Astro.props as {entry:LibraryEntry};
let code=`---
import ${e.component} from '../components/library/${e.component}.astro';
---
<${e.component} ${Object.entries(e.props).map(([k,v])=>typeof v==='string'?`${k}=${JSON.stringify(v)}`:`${k}={${JSON.stringify(v)}}`).join(' ')} />`;
if(e.group==='layout'&&e.slug!=='divider')code=code.replace(' />',`>\n  <div>First item</div>\n  <div>Second item</div>\n</${e.component}>`).replace("../components/library/","../components/layout/");
if(e.slug==='divider')code=code.replace("../components/library/","../components/layout/");
if(e.slug==='card'||e.slug==='empty-state'){
 const typography=e.slug==='empty-state';
 code=code.replace(';\n---\n', ";\nimport TextLink from '../components/actions/TextLink.astro';\n---\n").replace(' />',`>\n  <TextLink href="/foundations/${typography?'typography':'colour'}/">Explore ${typography?'typography':'colour'}</TextLink>\n</${e.component}>`);
}
const events=e.slug==='pagination'?['samvad:pagechange','page']:e.slug==='dropdown-menu'?['samvad:select','value']:e.slug==='confirmation-dialog'?['samvad:confirm','']:undefined;
const toc=[{id:'preview',label:'Live preview'},{id:'properties',label:'Properties and variants'},{id:'states',label:'States and interaction'},{id:'usage',label:'Usage'},{id:'accessibility',label:'Accessibility'},{id:'implementation',label:'Implementation'},{id:'foundations',label:'Related foundations'}];
const optional:Record<string,Record<string,unknown>>={avatar:{src:'optional URL',decorative:false},list:{ordered:false},'feedback-states':{announce:false,dismissible:false},alert:{announce:false},'loading-state':{},tabs:{selected:0},breadcrumbs:{},'skeleton-loader':{},dialog:{'default slot':'optional content'},drawer:{'default slot':'optional content'},popover:{'default slot':'optional content'},'confirmation-dialog':{},card:{'default slot':'optional content'},'empty-state':{'default slot':'optional action'}};
const properties={...(e.group==='layout'&&e.slug!=='divider'?{'default slot':'Required child content'}:{}),...(optional[e.slug]||{}),...e.props};
const layoutNotes:Record<string,string>={max:'Content maximum: 640, 960, 1200, reading (65ch), or full; default 960.',padding:'responsive gutters (default), or any approved numeric spacing value.',orientation:'horizontal (default) or vertical. Vertical needs a row parent with height.',decorative:'false (default) exposes separator semantics; true is purely decorative.',inset:'Approved spacing at both ends of the rule axis; default 0.',direction:'vertical (default) or horizontal.',gap:'Approved spacing value between children; default 16.',align:'Cross-axis alignment: start, center, end or stretch (default).',justify:'Main-axis distribution: start (default), center, end or between.',wrap:'true (default) lets horizontal content wrap; false requires children to fit.',collapse:'false (default); true makes a horizontal Stack vertical below 600px.',columns:'Base integer column count (1–12); default 1.',medium:'Column count from 600px when responsive; default 2.',wide:'Column count from 1024px when responsive; default 3.',responsive:'true (default) uses breakpoint counts; false keeps columns at every width.'};
const propNotes:Record<string,string>={id:'Required unique DOM ID; related labels and controls derive from it.',label:'Visible or accessible name appropriate to this component.',title:'Visible heading or status title.',description:'Supporting content; use concise, meaningful text.',message:'Status message; no network or saved result is implied.',tone:'Semantic colour treatment; defaults are documented in the source.',size:'Approved foundation dimensions, with provisional component assignment.',items:'Structured data array; labels are visible text, not HTML.',rows:'Local records keyed by column definitions.',columns:'Keys, visible labels and optional sortable flag.',current:'Zero-based current step index.',page:'One-based current page; default 1.',total:'Known total pages; default 5. Supply positive integers.',value:'Measured progress; omit for indeterminate.',max:'Progress maximum; default 100. Supply a positive value.',selected:'Zero-based initial enabled tab; defaults 0.',name:'Accessible person name and source for fallback initials.',src:'Optional image URL; broken images reveal initials.',decorative:'Hide duplicated avatar meaning from assistive technology; default false.',dismissible:'Expose a named dismissal control; default false.',announce:'Opt in to live status/error semantics; default false.',triggerLabel:'Explicit name of the button that reveals the component.',confirmLabel:'Name of the consequential confirmation action.',steps:'Ordered labels for the example sequence.',caption:'Visible table caption.',density:'comfortable (default) or compact cells.',variant:'Presentation variant; does not add behaviour.',lines:'Placeholder count, default 3; clamped 1–10.',text:'Short optional tooltip explanation.',ordered:'Render an ordered list when sequence matters; default false.'};
---
<DocsLayout page={`library-${e.slug}`} toc={toc}>
 <article class="component-docs">
  <p class="component-preview-notice"><strong>Reusable component · production token mapping pending.</strong> Built from the existing approved foundations and shared local components. No new official token API, Figma asset or product screen is implied.</p>
  <section class="doc-section" id="preview"><h2>Try it out.</h2><p>{e.description} The preview uses the actual reusable implementation.</p><LibraryPlayground entry={e}/></section>
  <section class="doc-section" id="properties"><h2>Properties and variants</h2><p>{e.variants}</p><div class="table-wrap"><table class="data-table"><thead><tr><th>Property</th><th>Preview configuration</th><th>Purpose</th></tr></thead><tbody>{Object.entries(properties).map(([key,value])=><tr><td>{key}</td><td><code>{JSON.stringify(value)}</code></td><td>{(e.group==='layout'?layoutNotes[key]:propNotes[key])||(key==='default slot'?'Compose real child content inside opening and closing component tags.':'Initial configuration passed to the reusable component.')}</td></tr>)}</tbody></table></div><p>See the typed Props interface in the imported local source for optional configuration. IDs must be unique per instance. Copyable examples use the exact initial preview props.</p></section>
  <section class="doc-section" id="states"><h2>States and interaction</h2><p>{e.states}</p><p>Use the preview controls where supplied. Native links and buttons retain pointer and keyboard activation; passive containers do not acquire artificial interactive states.</p></section>
  <section class="doc-section" id="usage"><h2>Use with intent.</h2><h3>When to use</h3><p>{e.use}</p><h3>When not to use</h3><p>{e.avoid}</p></section>
  <section class="doc-section" id="accessibility"><h2>Accessibility</h2><p>{e.a11y}</p><p>Interactive targets are at least 44px, focus is visible, labels wrap and meaning is not conveyed by colour alone. Verify the consuming context with assistive technology and real device input; these checks do not constitute a complete WCAG certification.</p></section>
  <section class="doc-section" id="implementation"><h2>Developer implementation</h2><p>{e.notes}</p><p>This reference example matches the initial preview configuration. Configured Layout examples are available directly beneath their live preview.</p><CodeBlock code={code}/>
   {events&&<><p>Optional consumer event listener. Give the preview instance a unique containing element with <code>id="example-host"</code> and an adjacent <code>&lt;p id="example-result" role="status"&gt;&lt;/p&gt;</code>.</p><CodeBlock code={`<script>
  document.getElementById('example-host')?.addEventListener('${events[0]}', event => {
    const result = document.getElementById('example-result');
    if (result) result.textContent = ${events[1]?`String((event as CustomEvent).detail.${events[1]})`:`'Confirmation received. Connect your operation here.'`};
  });
</script>`}/></>}
   <p>Import from local Astro sources. Shared runtime is bundled once by Astro. Supported styles consume the generated Semantic/Component token exports. Candidate role assignments and retained literals are documented in Design Tokens; standalone packaging remains pending. Slots accept real content, not HTML strings. {e.group==='layout'&&'Layout components need no client JavaScript; configuration controls are documentation tooling.'}</p>
  </section>
  <section class="doc-section" id="foundations"><h2>Related foundations and token status.</h2><p>Supported styles now consume the local token exports. See <a href={href('design-tokens/')}>Design Tokens</a> for actual alias mappings, candidate status and retained declarations.</p><p>Geist, warm neutrals and mulberry action/focus values; success, warning, error and info foundation ramps where relevant. Spacing uses the approved 4px grid; radii 4/8/full; interactive targets 44px; focus 2px with 2px offset; reviewed foundation/exception shadows, 120ms action transitions and explicit 960ms loading cadence. Tone contrast is verified from the actual paired values in both modes.</p><p>{e.pending} The five reviewed token decisions are approved: quiet Dark boundaries, popup/toast effects, field labels/helpers, large controls/focus/capsules and button/loading motion. Unrelated candidate assignments remain provisional; this is not a public package release. {e.group==='layout'?'Component defaults remain provisional implementation assignments. No global breakpoint or spacing foundation was changed.':'Toast timing/queuing, advanced table features, nested overlays and legacy Popover API fallbacks are outside the implemented variants.'}</p></section>
 </article>
</DocsLayout>
