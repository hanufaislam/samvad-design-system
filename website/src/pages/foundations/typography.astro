---
import ExistingPageExtras from '../../components/foundation-docs/ExistingPageExtras.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { foundation } from '../../data';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
const source=readFileSync(resolve('../design-system/foundations/typography.md'),'utf8');
const sourceNote=source.split('\n\n')[1].replaceAll('**','');
---
<DocsLayout page="typography" toc={[{id:'family',label:'The type family'},{id:'scale',label:'The type scale'},{id:'mono',label:'Monospace'},{id:'guidance',label:'Usage and accessibility'},{id:'approved-mappings',label:'Approved mappings'},{id:'connections',label:'Related references'}]}>
  <section id="family" class="doc-section"><div class="type-intro"><span class="type-big">Geist<span class="brand-dot">.</span></span><code>Regular 400 / Semibold 600</code></div><p class="identity-caption">{sourceNote}</p></section>
  <section id="scale" class="doc-section"><h2>Character, at every size.</h2><p>Ten roles share one clear hierarchy. Try a phrase to see the approved sizes, line heights and weights in context.</p><label class="specimen-input"><span>Try your own text</span><input id="type-input" type="text" maxlength="120" placeholder="A little character. A lot of clarity." aria-describedby="type-input-note"/></label><p id="type-input-note" class="identity-caption">A live type specimen. Your text stays in this browser and is not saved.</p><div class="type-specimens">{foundation.typography.map(t=><div class="type-specimen"><div class="type-meta"><span>{t.name}</span><span>{t.size} / {t.lineHeight} · {t.weight} · {t.trackingEm}em</span></div><p class="type-example" data-type-example style={{fontSize:`var(--samvad-semantic-type-${t.name.replaceAll('/','-')}-size)`,lineHeight:`var(--samvad-semantic-type-${t.name.replaceAll('/','-')}-line-height)`,fontWeight:`var(--samvad-semantic-type-${t.name.replaceAll('/','-')}-weight)`,letterSpacing:`var(--samvad-semantic-type-${t.name.replaceAll('/','-')}-tracking)`}}>A little character. A lot of clarity.</p></div>)}</div></section>
  <section id="mono" class="doc-section"><h2>A quieter technical voice.</h2><p>Geist Mono is reserved for technical labels and selected numerical content.</p><div class="mono-specimen" style="font-family:var(--samvad-semantic-font-family-mono);font-size:var(--samvad-semantic-type-label-size);line-height:var(--samvad-semantic-type-label-line-height);font-weight:var(--samvad-semantic-font-weight-regular)"><p>Geist Mono · Regular · 14 / 20</p><p>Aa Bb Cc &nbsp; 0123456789</p><p>space/24 &nbsp; radius/md &nbsp; #742653</p></div></section>
  <section id="guidance" class="doc-section"><h2>Readability comes first.</h2><ul class="checklist"><li>Keep body text at its intended size. Let containers grow and content wrap.</li><li>Use tighter tracking only for Latin headings. Native scripts need appropriate font companions and line boxes.</li><li>Respect text enlargement and platform font scaling. Choose smaller heading roles when space is limited.</li><li>Use hierarchy, whitespace and weight before adding more colours.</li></ul><p class="source-note">Source: existing <code>typography.md</code> and <code>foundation-spec.json</code>. The shell uses locally served Geist fonts. Final component mappings and script fallback/delivery limitations are documented below.</p></section>
  <ExistingPageExtras page="typography"/>
</DocsLayout>
